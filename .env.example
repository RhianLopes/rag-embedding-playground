# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# QDRANT_API_KEY=your_api_key_here   # optional for local dev

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434

# ── Default models ────────────────────────────────────────────────────────────
# Embedding models (sentence-transformers, runs locally via HuggingFace)
EMBEDDING_MODEL_SMALL=sentence-transformers/all-MiniLM-L6-v2     # 384d, fast
EMBEDDING_MODEL_BASE=sentence-transformers/all-mpnet-base-v2     # 768d, balanced
EMBEDDING_MODEL_LARGE=sentence-transformers/all-roberta-large-v1  # 1024d, accurate

# LLM via Ollama (pull with: docker exec ollama ollama pull <model>)
LLM_MODEL=llama3.2        # default chat model (~2GB)
LLM_MODEL_LARGE=mistral   # alternative (~4GB)

# ── Jupyter ───────────────────────────────────────────────────────────────────
JUPYTER_PORT=8888
